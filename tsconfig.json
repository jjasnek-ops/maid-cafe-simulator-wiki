{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "tools",
    "tests/upstream-only/**",
    "tests/fixtures/**"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ]
    },
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve"
  }
}
