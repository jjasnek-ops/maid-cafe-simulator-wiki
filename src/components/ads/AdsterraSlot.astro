---
/** One original-size creative per isolated file, loaded after consent and visibility. */
import { currentSharedStrings } from '~/lib/shared-ui';
import { needsTrackingConsent } from '~/lib/adsterra-config';
interface Props {
  name: string;
  width: number;
  height: number;
  label?: boolean;
  hideOnMobile?: boolean;
  compact?: boolean;
  responsive?: boolean;
}
const { name, width, height, label = true, hideOnMobile = false, compact = false, responsive = false } = Astro.props;
const envKey = `PUBLIC_ADSTERRA_SLOT_${name.replace(/-/g, '_').toUpperCase()}`;
const show = !!import.meta.env[envKey];
const adLabel = currentSharedStrings(Astro.currentLocale).adLabel ?? 'Advertisement';
const iframeSrc = `/ads/${name}.html`;
---
{show && <>
  <div
    class:list={['max-w-full flex-col items-center justify-center', compact ? 'm-0' : 'my-8', hideOnMobile ? 'hidden md:flex' : 'flex']}
    data-adsterra-slot={name}
    data-adsterra-width={responsive ? '0' : width}
    data-adsterra-consent={needsTrackingConsent ? '1' : '0'}
  >
    {label && <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">{adLabel}</span>}
    <iframe
      data-src={iframeSrc}
      data-adsterra-native={responsive ? '1' : undefined}
      style={`width:100%;max-width:${width}px;height:${height}px;border:0`}
      loading="lazy"
      sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
      title={adLabel}
    />
  </div>
  <script is:inline>
    /* ES2018; one page-level initializer even when several slots render.
       Never request hidden/oversized creatives or duplicate unit files. */
    (function () {
      if (window.__awAdsterraScheduled) return;
      window.__awAdsterraScheduled = true;
      var CONSENT_KEY = 'aw-cookie-consent';
      var CONSENT_EVENT = 'aw:consent-accepted';
      var init = function () {
        var slots = Array.prototype.slice.call(document.querySelectorAll('[data-adsterra-slot]'));
        var loaded = {};
        var accepted = false;
        try { accepted = localStorage.getItem(CONSENT_KEY) === 'accepted'; } catch (e) { /* await choice */ }
        var fit = function (slot) {
          var width = Number(slot.getAttribute('data-adsterra-width'));
          var available = slot.parentElement ? slot.parentElement.clientWidth : 0;
          slot.style.display = width > available ? 'none' : '';
          return slot.clientWidth >= width && slot.clientWidth > 0;
        };
        var load = function (slot) {
          if (!slot.isConnected || !fit(slot)) return;
          if (slot.getAttribute('data-adsterra-consent') === '1' && !accepted) return;
          var rect = slot.getBoundingClientRect();
          if (rect.bottom <= 0 || rect.top >= window.innerHeight) return;
          var frame = slot.querySelector('iframe[data-src]');
          if (!frame) return;
          var src = frame.getAttribute('data-src');
          if (loaded[src]) return;
          loaded[src] = true;
          frame.src = src;
          frame.removeAttribute('data-src');
        };
        var observer = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) { if (entry.isIntersecting) load(entry.target); });
        }) : null;
        slots.forEach(function (slot) { fit(slot); if (observer) observer.observe(slot); load(slot); });
        var retry = function () { slots.forEach(load); };
        document.addEventListener(CONSENT_EVENT, function () { accepted = true; retry(); });
        window.addEventListener('resize', retry);
        if (!observer) window.addEventListener('scroll', retry, { passive: true });
        // Only the native unit may report its natural content height. Verify
        // both origin and source; fixed-size banners are never resized.
        window.addEventListener('message', function (event) {
          if (event.origin !== window.location.origin || !event.data || event.data.type !== 'aw-native-height') return;
          var height = Number(event.data.height);
          if (!isFinite(height) || height < 50 || height > 1600) return;
          slots.forEach(function (slot) {
            var frame = slot.querySelector('iframe[data-adsterra-native]');
            if (frame && frame.contentWindow === event.source) frame.style.height = Math.ceil(height) + 'px';
          });
        });
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
  </script>
</>}
