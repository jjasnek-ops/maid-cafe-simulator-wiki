---
import { Icon } from 'astro-icon/components';
import AdsterraSlot from './AdsterraSlot.astro';
import { currentSharedStrings } from '~/lib/shared-ui';
const show = !!import.meta.env.PUBLIC_ADSTERRA_SLOT_STICKY_320X50;
const labels = currentSharedStrings(Astro.currentLocale);
const stickyCss = `
  html.has-top-ad { scroll-padding-top: 9rem; }
  .has-top-ad .prose :is(h2, h3, h4) { scroll-margin-top: 0; }
  .has-top-ad main .sticky.top-20 { top: 9rem; }
`;
---
{show && <>
  <aside id="sticky-ad" class="sticky top-14 z-30 border-b border-border bg-background/95 px-0 py-2 backdrop-blur" aria-label={labels.adLabel}>
    <div class="relative mx-auto max-w-7xl">
      <div class="mb-1 flex h-5 items-center justify-center">
        <span class="text-[10px] uppercase tracking-wider text-muted-foreground">{labels.adLabel}</span>
        <button type="button" id="dismiss-sticky-ad" class="absolute right-3 rounded-md p-1 text-muted-foreground hover:bg-muted" aria-label={labels.closeAd}>
          <Icon name="lucide:x" class="h-4 w-4" />
        </button>
      </div>
      <AdsterraSlot name="sticky-320x50" width={320} height={50} label={false} compact />
    </div>
  </aside>
  <script is:inline>
    (function () {
      var ad = document.getElementById('sticky-ad');
      var button = document.getElementById('dismiss-sticky-ad');
      var key = 'aw-sticky-ad-dismissed';
      if (!ad) return;
      try { if (sessionStorage.getItem(key) === '1') { ad.remove(); return; } } catch (e) { /* dismissal still works */ }
      document.documentElement.classList.add('has-top-ad');
      if (button) button.addEventListener('click', function () {
        try { sessionStorage.setItem(key, '1'); } catch (e) { /* dismissal still works */ }
        ad.remove();
        document.documentElement.classList.remove('has-top-ad');
      });
    })();
  </script>
  <style set:html={stickyCss} />
</>}
